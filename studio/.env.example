# Copy to .env (or .env.local) inside this studio/ folder. Not committed.
#
# These are the same project as CMS_PROJECT_ID / CMS_DATASET in the main
# app's .env.local — just under the env var names Sanity's own tooling reads
# (SANITY_STUDIO_* is required here; the Next app cannot read these directly
# since it's a separate project with its own env file).
#
# Neither value is secret — no write/read token belongs in this folder. This
# Studio authenticates editors with their own Sanity login (npx sanity login),
# never with the app's CMS_READ_TOKEN.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
