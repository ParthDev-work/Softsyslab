###############################################################################
# SoftSysLab — environment configuration
#
# Copy to .env.local for development. In production set these in the Vercel
# project settings rather than committing a file (PRD section 39: environment
# files are not committed, and no secret is placed in a NEXT_PUBLIC_ variable).
#
# Everything in this file is either public configuration or a placeholder. No
# real secret belongs in .env.example — it is committed.
#
# Variables marked REQUIRED must be set before the production deployment is
# treated as published. Variables marked LATER belong to capabilities this
# build does not have yet; they are listed so the shape of the eventual
# configuration is visible, and so nobody has to rediscover it.
###############################################################################

# --- Canonical origin --------------------------------------------- REQUIRED
# The one canonical HTTPS hostname, origin only, no trailing slash
# (section 47). Self-canonicals, the sitemap, robots.txt and the API origin
# check are all derived from this. Leave unset locally to use localhost.
NEXT_PUBLIC_SITE_ORIGIN=https://your-domain.example

# --- Indexing ------------------------------------------------------ REQUIRED
# "true" only on the canonical production host, and only once the launch
# checklist has passed. Anything else serves noindex and an empty sitemap, so a
# preview deployment cannot be indexed (section 47).
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Transport ------------------------------------------------------ OPTIONAL
# Section 44 puts HSTS behind a domain and subdomain readiness review, so it is
# off unless explicitly enabled. Turn it on only when every subdomain is served
# over HTTPS — it is difficult to walk back.
ENABLE_HSTS=false

# --- API origin allowlist ------------------------------------------- OPTIONAL
# Comma-separated origins accepted by POST /api/contact. Defaults to
# NEXT_PUBLIC_SITE_ORIGIN. Add a preview origin here only if you need to post
# to the API from one.
# ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# --- Lead store ----------------------------------------------------- CURRENT
# "file"  — append each enquiry to LEAD_STORE_FILE as JSON lines (the default)
# "none"  — reject every write, so POST /api/contact answers 503
#
# Neither is durable. On Vercel the filesystem is ephemeral, so a saved enquiry
# does not outlive the instance. The contact page says so to the visitor rather
# than implying an enquiry has been filed. Replace this with the Postgres
# implementation described in docs/api-contract.md before launch.
LEAD_STORE=file
# LEAD_STORE_FILE=.data/leads.jsonl


###############################################################################
# NOT YET IMPLEMENTED
#
# The variables below are placeholders for the backend the PRD specifies and
# this build does not have. Nothing reads them today. They are listed so that
# whoever connects each service knows the name to use, and so no secret ends up
# invented ad hoc. Fill in the value when the corresponding capability is built
# — adding a value alone changes nothing.
###############################################################################

# --- Operational database (PRD section 42) --------------------------- REQUIRED
# Managed PostgreSQL, hosted on Supabase. Holds submissions, leads, outbox
# events, idempotency keys, consent receipts and audit records (schema in
# prisma/schema.prisma).
#
# Supabase gives you three connection strings under
# Project Settings -> Database -> Connection string. This app needs two of them:
#
#   DATABASE_URL     = the "Transaction pooler" string (port 6543).
#                       Used by the app at runtime (every API route, every
#                       serverless function invocation). Transaction-mode
#                       pgbouncer handles many short-lived connections cheaply,
#                       which is what a serverless deployment opens on every
#                       request. Append `?pgbouncer=true&connection_limit=1` —
#                       Prisma needs that flag to disable prepared statements,
#                       which pgbouncer transaction mode does not support.
#
#   DATABASE_DIRECT_URL = the "Session pooler" string (port 5432).
#                       Used only for `prisma migrate` / `prisma db push` /
#                       introspection, which need a session-scoped connection
#                       with prepared-statement support that the transaction
#                       pooler cannot give them. If your network is IPv6-capable
#                       you may use the plain "Direct connection" string here
#                       instead of the session pooler — either works for
#                       migrations, the session pooler is just IPv4-safe.
#
# Paste your project's two connection strings in below, with your database
# password filled in (Supabase shows the strings with a `[YOUR-PASSWORD]`
# placeholder — replace it, don't leave it literal).
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DATABASE_DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Transactional email (PRD section 37) ----------------------------- LATER
# Verified sending domain with SPF, DKIM and a monitored DMARC rollout.
# Transactional and marketing streams stay separate.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_REPLY_TO_ADDRESS=

# --- Headless CMS (PRD section 34) ------------------------------ CURRENT
# Sanity. Vendor chosen; studio/ holds the schema and src/lib/content holds
# the ContentSource implementation (src/lib/content/sanitySource.ts).
#
# Leave all four unset and the app reads src/content/*.ts exactly as before
# (see selectContentSource in src/lib/content/index.ts) — nothing below is
# required to run this app. Set all four and every page switches to Sanity.
#
# CMS_PROJECT_ID / CMS_DATASET — from manage.sanity.io, or from
#   studio/.env's SANITY_STUDIO_PROJECT_ID / SANITY_STUDIO_DATASET (same
#   project, different env var names — that's Sanity's own CLI convention
#   for the Studio, not this app's).
# CMS_READ_TOKEN — a **Viewer**-permission API token (manage.sanity.io ->
#   API -> Tokens). Server-side only, never exposed to the browser. A wider
#   token works but grants this app more than it needs to read content.
# CMS_WEBHOOK_SECRET — a secret you choose, entered when creating the
#   webhook in manage.sanity.io -> API -> Webhooks pointed at
#   https://<your-render-url>/api/webhooks/cms. See the projection and setup
#   notes in src/app/api/webhooks/cms/route.ts.
#
# One-time only, never set in a deployed environment: CMS_WRITE_TOKEN, an
# Editor-permission token, used solely by `npm run migrate:cms` to seed the
# dataset from src/content/*.ts. Pass it inline on the command that runs the
# script — see scripts/migrate-content-to-sanity.ts.
# CMS_PROJECT_ID=
# CMS_DATASET=
# CMS_READ_TOKEN=
# CMS_WEBHOOK_SECRET=

# --- Object storage and malware scanning (PRD section 39) ------------- LATER
# Required before any file upload is enabled. REQ-UPLOAD-01: without scanning,
# the attachment interface is removed rather than built — which is why no file
# input exists anywhere in this build.
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MALWARE_SCANNER_API_KEY=

# --- CRM (PRD section 36) --------------------------------------------- LATER
# The submission UUID is the external idempotency identifier.
# CRM_API_KEY=
# CRM_BASE_URL=

# --- Bot prevention (PRD section 39) ---------------------------------- LATER
# Adaptive controls with an accessible fallback. The client token is never
# trusted without server-side verification.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Analytics (PRD sections 38 and 45) ------------------------------- LATER
# Consent-gated. lib/analytics already holds the gate and the event vocabulary;
# a vendor is wired in behind it, never beside it. A site key here is public by
# design, which is why it may carry the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Error and uptime monitoring (PRD section 50) --------------------- LATER
# Must scrub form fields, tokens and file names before export.
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Uptime/synthetic monitoring (2+ regions, PRD section 50) is a third-party
# dashboard, not app code — point whichever vendor you pick (e.g. Better
# Stack, UptimeRobot, Checkly) at GET /api/health. It reads no secret from
# this app, so there is nothing to add here beyond the vendor's own config.

# --- Internal notification (PRD section 39) --------------------------- LATER
# Short summary and a protected lead link only — never attachments or full
# enquiry narratives.
# SLACK_WEBHOOK_URL=

###############################################################################
# CI/CD secrets — do NOT put these here
#
# These live in GitHub repo secrets (Settings -> Secrets and variables ->
# Actions), not in any .env file, because .github/workflows/ci.yml reads them
# at pipeline time, before any app process starts. Listed here only so the
# name is known in one place:
#
#   VERCEL_TOKEN        — personal/team token from vercel.com/account/tokens
#   VERCEL_ORG_ID        — from the Vercel project's Settings -> General
#   VERCEL_PROJECT_ID    — same page as above
#   LHCI_GITHUB_APP_TOKEN — optional; only if you install the Lighthouse CI
#                           GitHub App to get PR status checks instead of
#                           plain workflow logs
###############################################################################
